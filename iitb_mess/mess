#!/usr/bin/env python3

import pandas as pd
import datetime
import requests
from io import StringIO
import math
from rich.console import Console
from rich.table import Table
from rich.panel import Panel
from rich.text import Text

SHEET_URL = "https://docs.google.com/spreadsheets/d/1sFBhxfaTkvMpST4VMKWi8qYtMSEvdyFt/export?format=csv&gid=159509381"

# Important category labels (arrow)
IMPORTANT_TAGS = {
    "main dish", "main", "dry", "gravy", "dal", "rice", "indian bread", "chutney",
    "snack", "dry vegetable", "curry", "special rice", "soup",
    "sweet dish", "desserts", "sweet dish /desserts", "extras*",
    "sambhar", "rasam", "sambhar/rasam", "rasam/sambhar"
}

# Meal headers
MEAL_HEADERS = {"BREAKFAST", "LUNCH", "TIFFIN", "DINNER"}

# Color per meal
MEAL_COLORS = {
    "BREAKFAST": "bold cyan",
    "LUNCH": "bold green",
    "TIFFIN": "bold magenta",
    "DINNER": "bold yellow",
}

console = Console()


def fetch_csv(url):
    r = requests.get(url)
    r.raise_for_status()
    return pd.read_csv(StringIO(r.text))


def find_today_column(df):
    """Today’s date is in ROW 0."""
    today = datetime.date.today()

    date_row = df.iloc[0]
    for col in df.columns[2:]:
        cell = str(date_row[col]).strip()
        if cell:
            try:
                parsed = pd.to_datetime(cell).date()
                if parsed == today:
                    return col
            except:
                pass
    return None


def is_header(value):
    return str(value).strip().upper() in MEAL_HEADERS


def clean(text):
    return str(text).strip().lower()


def value_or_none(v):
    """Convert NaN → None."""
    if v is None:
        return None
    if isinstance(v, float) and math.isnan(v):
        return None
    if str(v).strip().lower() == "nan":
        return None
    if str(v).strip() == "":
        return None
    return str(v).strip()


def style_item(label, item):
    """Style important items with arrow and color using Rich."""
    if not item:
        return None
    label_clean = clean(label)
    if label_clean in IMPORTANT_TAGS:
        return Text(f"▶ {item}", style="bold white")
    return Text(f"• {item}", style="white")


def collect_meals(df, today_col):
    """Return dict: meal -> list[Text] of styled items."""
    meals = {m: [] for m in MEAL_HEADERS}
    current_meal = None

    for i in range(1, len(df)):
        colA = value_or_none(df.iloc[i, 0])
        colB = value_or_none(df.iloc[i, 1])
        item = value_or_none(df.at[i, today_col])

        # Section header switches current meal
        if colA and is_header(colA):
            current_meal = colA.strip().upper()
            # continue

        # Skip empty rows
        if not colA and not colB:
            continue

        if not item:
            continue

        # Determine category label (A preferred, otherwise B)
        label = colA if (colA and not is_header(colA)) else colB
        if not label:
            label = "other"

        styled = style_item(label, item)
        if styled and current_meal in meals:
            meals[current_meal].append(styled)

    return meals


def render_table(meals, date_text):
    table = Table(show_header=True, header_style="bold", box=None, padding=(0, 1))
    table.add_column("BREAKFAST", style=MEAL_COLORS["BREAKFAST"])
    table.add_column("LUNCH", style=MEAL_COLORS["LUNCH"])
    table.add_column("TIFFIN", style=MEAL_COLORS["TIFFIN"])
    table.add_column("DINNER", style=MEAL_COLORS["DINNER"])

    max_len = max(
        len(meals["BREAKFAST"]),
        len(meals["LUNCH"]),
        len(meals["TIFFIN"]),
        len(meals["DINNER"]),
    )

    def get_item(meal, idx):
        items = meals[meal]
        if idx < len(items):
            return items[idx]
        return Text("")

    for i in range(max_len):
        table.add_row(
            get_item("BREAKFAST", i),
            get_item("LUNCH", i),
            get_item("TIFFIN", i),
            get_item("DINNER", i),
        )

    title = Text(f"Menu for {date_text}", style="bold white on blue")
    console.print(Panel(table, title=title, border_style="blue"))


def main():
    df = fetch_csv(SHEET_URL)

    today_col = find_today_column(df)
    if not today_col:
        console.print("[red]Today's column not found in sheet.[/red]")
        return

    today = datetime.date.today()
    date_text = f"{today.strftime('%A').upper()} - {today.strftime('%d-%b-%Y')}"

    meals = collect_meals(df, today_col)
    render_table(meals, date_text)


if __name__ == "__main__":
    main()
